<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A0000"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚨  CRASH DETECTED"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FF3333"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Are you OK? Press the button below to cancel SOS."
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sending SOS in 10s"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <ProgressBar
        android:id="@+id/progressSos"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:max="10"
        android:progress="10"
        android:progressTint="#FF4444"
        android:progressBackgroundTint="#2A0000"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnCancelSOS"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="✅  I'M OK — CANCEL SOS"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#44FF44"
        android:backgroundTint="#1A3A1A"/>

</LinearLayout>