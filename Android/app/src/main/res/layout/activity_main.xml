<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:padding="16dp"
    android:gravity="center">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚨  Crash Detection"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FF4444"
        android:layout_marginBottom="16dp"
        android:gravity="center"/>

    <!-- Sensor Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SENSOR DATA"
            android:textSize="11sp"
            android:textColor="#666666"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvAx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ax: 0.00 m/s²"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvAy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ay: 0.00 m/s²"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvAz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="az: 0.00 m/s²"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="gx: 0.00 °/s"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="|a|: 0.00 m/s²"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF8C00"
                    android:fontFamily="monospace"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS Speed: 0.0 km/h"
            android:textSize="14sp"
            android:textColor="#4CAF50"
            android:fontFamily="monospace"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

    <!-- Confidence Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRASH CONFIDENCE"
            android:textSize="11sp"
            android:textColor="#666666"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#44FF44"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <ProgressBar
            android:id="@+id/progressConf"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#44FF44"
            android:progressBackgroundTint="#2A2A2A"/>

    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● Idle — press START"
        android:textSize="13sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Start / Stop Button -->
    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="▶  START MONITORING"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#44FF44"
        android:backgroundTint="#1A3A1A"
        android:layout_marginTop="4dp"/>

</LinearLayout>
